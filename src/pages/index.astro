---
// The site root: on to the editor (keeping ?... and #..., so #pose= links work), with the link
// card, since link previews do not follow the redirect. Before Astro, the Pages workflow wrote
// this page as web/index.html.
const title = "立体人形装置 ODM Poser";
const description =
	"線と丸の全身アタリを、疑似3Dで動かすポーズエディタ。ブラウザだけで動き、PC・スマホ・タブレットで使えます。アタリ画像・OpenPose 画像・ポーズを書き出せます。";
const url = new URL(import.meta.env.BASE_URL.replace(/\/?$/, "/"), Astro.site).href;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={title} />
		<meta property="og:title" content={`${title} — Omni-Directional Mannequin Poser`} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={`${url}editor/og-card.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="立体人形装置 ODM Poser：線と丸の人形とパース定規" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>location.replace("editor/index.html" + location.search + location.hash);</script>
		<noscript><meta http-equiv="refresh" content="0; url=editor/index.html" /></noscript>
	</head>
	<body><a href="editor/index.html">{title}</a></body>
</html>
